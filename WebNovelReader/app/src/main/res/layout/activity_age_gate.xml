<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <EditText
            android:id="@+id/editGateUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="年齢確認が必要なサイトのURL"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnOpenGate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="開く" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp"
        android:text="下の画面でサイトの「はい」「同意する」等をタップして年齢確認を通過してから、下の「確認完了・保存」ボタンを押してください。" />

    <Button
        android:id="@+id/btnConfirmDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="確認完了・保存" />

    <TextView
        android:id="@+id/statusGate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="@color/app_accent" />

    <WebView
        android:id="@+id/gateWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
